---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<Layout title="Work with Me | Magda Kaspary" description="The work that brought me here is the same work I bring to every engagement: understanding the invisible forces that shape how people lead, collaborate, and thrive." lang="en">
  <Header slot="header" />

  <!-- PAGE HEADER -->
  <div class="max-w-[68rem] mx-auto px-8 pt-16 pb-8 border-b border-stone">
    <p class="section-eyebrow">Work with Me</p>
    <h1 class="font-serif text-[2.8rem] font-normal leading-[1.15] text-ink mt-3 max-w-[36rem]">Coaching, facilitation, and advisory for leaders navigating the hard questions.</h1>
  </div>

  <!-- FRAMING -->
  <div class="max-w-[68rem] mx-auto px-8 py-16 border-b border-stone">
    <div class="max-w-[48rem]">
      <p class="text-[1.15rem] leading-[1.85] text-ink">The work that brought me here is the same work I bring to every engagement: trying to understand the invisible forces that shape how people lead, collaborate, and thrive — or don't. My clients don't come to me because they want a framework. They come because they're sitting with a question they can't quite answer alone, and they want a thinking partner who won't reduce it.</p>
    </div>
  </div>

  <!-- OFFERINGS -->
  <div class="max-w-[68rem] mx-auto px-8 py-20 border-b border-stone">
    <p class="section-eyebrow mb-12">Offerings</p>
    <div class="offerings-grid">

      <div class="offering-card">
        <div class="offering-number">01</div>
        <h2 class="offering-name">1:1 Leadership Coaching</h2>
        <p class="offering-desc">For senior leaders and managers navigating complexity, transition, or the distance between who they are and who they want to become. As an ICF-certified coach, I draw from psychology, systems thinking, and intercultural intelligence to help you see what you're too close to see alone. This is not a program — it's a thinking relationship.</p>
        <div class="offering-for">
          <span class="offering-label">Who it's for</span>
          <p>Executives, senior managers, and HR leaders who want depth, not scripts. People who've outgrown the usual answers.</p>
        </div>
        <div class="offering-step">
          <span class="offering-label">First step</span>
          <a href="https://cal.com/magda-c-kaspary-mewyzp" target="_blank" rel="noopener" class="btn-offering">Schedule a 45-minute discovery conversation →</a>
        </div>
      </div>

      <div class="offering-card">
        <div class="offering-number">02</div>
        <h2 class="offering-name">Team Facilitation &amp; Development</h2>
        <p class="offering-desc">For leadership teams that keep hitting the same walls regardless of who's in the room. I design and facilitate workshops and working sessions that address the dynamics beneath the surface — not just the presenting problem. Each engagement starts with listening before proposing anything.</p>
        <div class="offering-for">
          <span class="offering-label">Who it's for</span>
          <p>Leadership teams in complex, multicultural, or fast-changing organizations who suspect the issue is systemic, not individual.</p>
        </div>
        <div class="offering-step">
          <span class="offering-label">First step</span>
          <a href="/en/contact" class="btn-offering">Start a scoping conversation →</a>
        </div>
      </div>

      <div class="offering-card">
        <div class="offering-number">03</div>
        <h2 class="offering-name">Organizational Advisory</h2>
        <p class="offering-desc">For HR leaders and senior executives designing culture change, leadership development programs, or intercultural capability initiatives. I partner as a thought leader and design collaborator — not a delivery vendor. If you're tired of off-the-shelf solutions and want something built for your specific organization, this is where we start.</p>
        <div class="offering-for">
          <span class="offering-label">Who it's for</span>
          <p>HR leaders and executives in mid-to-large organizations who are designing something new and want a rigorous thinking partner.</p>
        </div>
        <div class="offering-step">
          <span class="offering-label">First step</span>
          <a href="/en/contact" class="btn-offering">Start a conversation →</a>
        </div>
      </div>

    </div>
  </div>

  <!-- WHO THIS IS FOR -->
  <div class="bg-teal-light border-b border-stone">
    <div class="max-w-[68rem] mx-auto px-8 py-16">
      <p class="section-eyebrow mb-6">Who This Is For</p>
      <p class="text-[1.05rem] leading-[1.85] text-ink max-w-[52rem]">I work well with people who take the questions seriously — who aren't looking for a quick fix, a model to roll out, or a training to check a box. My clients tend to be curious, reflective, and frustrated by the gap between their organizations' potential and its current reality. Many have been in leadership long enough to know that the answers are rarely where they first looked. They're often navigating something that isn't in the playbook: a culture that resists change, a team with invisible fractures, a leadership identity that needs rebuilding after a hard chapter.</p>
    </div>
  </div>

  <!-- PROCESS -->
  <div class="max-w-[68rem] mx-auto px-8 py-20 border-b border-stone">
    <p class="section-eyebrow mb-12">How We Work Together</p>
    <div class="process-steps">
      <div class="process-step">
        <div class="process-num">1</div>
        <div>
          <h3 class="process-title">Discovery conversation</h3>
          <p class="process-desc">We talk about what's happening, what you've tried, and what you're hoping for. No agenda beyond understanding.</p>
        </div>
      </div>
      <div class="process-step">
        <div class="process-num">2</div>
        <div>
          <h3 class="process-title">Tailored proposal</h3>
          <p class="process-desc">I design an engagement specific to your situation: a coaching arc, a facilitation scope, or an advisory structure.</p>
        </div>
      </div>
      <div class="process-step">
        <div class="process-num">3</div>
        <div>
          <h3 class="process-title">Engagement begins</h3>
          <p class="process-desc">We work at the pace that serves the real work, not an arbitrary timeline.</p>
        </div>
      </div>
      <div class="process-step">
        <div class="process-num">4</div>
        <div>
          <h3 class="process-title">Ongoing reflection</h3>
          <p class="process-desc">Regular check-ins on what's shifting, what isn't, and what the work is teaching us.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="max-w-[68rem] mx-auto px-8 py-20 text-center">
    <h2 class="font-serif text-[2rem] font-normal text-ink mb-4">Ready to start a conversation?</h2>
    <p class="text-ink-muted mb-8 max-w-[36rem] mx-auto leading-relaxed">No commitment required — just a conversation to see if we're the right fit for each other.</p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="https://cal.com/magda-c-kaspary-mewyzp" target="_blank" rel="noopener" class="btn-primary">Schedule time with Magda</a>
      <a href="/en/contact" class="btn-outline">Send a message</a>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<style>
  .section-eyebrow {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .offerings-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .offering-card {
    border-top: 3px solid var(--color-teal);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .offering-number {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--color-teal);
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .offering-name {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-ink);
  }

  .offering-desc {
    font-size: 0.93rem;
    color: var(--color-ink-muted);
    line-height: 1.75;
    flex-grow: 1;
  }

  .offering-label {
    display: block;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 0.35rem;
  }

  .offering-for p {
    font-size: 0.88rem;
    color: var(--color-ink);
    line-height: 1.6;
    font-style: italic;
  }

  .btn-offering {
    display: inline-block;
    font-size: 0.82rem;
    color: var(--color-teal);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.03em;
    border-bottom: 1px solid var(--color-stone);
    transition: border-color 0.15s;
    margin-top: 0.25rem;
  }
  .btn-offering:hover { border-color: var(--color-teal); }

  .process-steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 48rem;
  }

  .process-step {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .process-num {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 300;
    color: var(--color-teal);
    line-height: 1;
    flex-shrink: 0;
    width: 2rem;
    text-align: center;
  }

  .process-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-ink);
    margin-bottom: 0.35rem;
  }

  .process-desc {
    font-size: 0.92rem;
    color: var(--color-ink-muted);
    line-height: 1.7;
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-teal);
    color: white;
    text-decoration: none;
    padding: 0.8rem 2.2rem;
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    transition: background 0.15s;
  }
  .btn-primary:hover { background: var(--color-teal-dark); }

  .btn-outline {
    display: inline-block;
    color: var(--color-teal);
    border: 1.5px solid var(--color-teal);
    text-decoration: none;
    padding: 0.8rem 2.2rem;
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    transition: background 0.15s, color 0.15s;
  }
  .btn-outline:hover { background: var(--color-teal); color: white; }

  @media (max-width: 900px) {
    .offerings-grid { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
