---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<Layout title="Writing | Magda Kaspary" description="Essays on leadership, culture, and the intersection of ideas. New pieces published on Interdisciplinarist — Magda's home for long-form thinking." lang="en">
  <Header slot="header" />

  <div class="coming-soon-page">
    <div class="max-w-[52rem] mx-auto px-8 py-24">
      <p class="eyebrow">Coming Soon</p>
      <h1 class="font-serif text-[3rem] font-normal leading-[1.1] text-ink mt-4 mb-8">Writing</h1>
      <p class="text-[1.15rem] leading-[1.8] text-ink mb-4">Essays on leadership, culture, and the intersection of ideas. New pieces published on <a href="https://interdisciplinarist.com" class="teal-link">Interdisciplinarist</a> — Magda's home for long-form thinking. Coming soon here.</p>
      <p class="text-[1rem] text-ink-muted leading-[1.75] mb-12">Subscribe to be the first to know when new essays are published.</p>

      <div class="embed-wrapper">
        <iframe
          src="https://embeds.beehiiv.com/ab3b485e"
          data-test-id="beehiiv-embed"
          width="100%"
          height="320"
          frameborder="0"
          scrolling="no"
          style="border-radius: 4px; border: 1px solid #DDD9D3; margin: 0; background-color: transparent;"
        ></iframe>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<style>
  .coming-soon-page {
    min-height: 60vh;
    border-bottom: 1px solid var(--color-stone);
  }
  .eyebrow {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  .embed-wrapper {
    max-width: 42rem;
  }
  .teal-link {
    color: var(--color-teal);
    text-decoration: none;
    border-bottom: 1px solid var(--color-stone);
    transition: border-color 0.15s;
  }
  .teal-link:hover { border-color: var(--color-teal); }
</style>
