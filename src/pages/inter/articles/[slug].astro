---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import HeaderInter from '../../../components/HeaderInter.astro';
import FooterInter from '../../../components/FooterInter.astro';
import GatedContent from '../../../components/GatedContent.astro';

const base = Astro.locals.site === 'interdisciplinarist' ? '' : '/inter';

const allArticles = await getCollection('articles');
const entry = allArticles.find((a) => a.id === Astro.params.slug);

if (!entry) {
  return Astro.rewrite('/404');
}

const { Content } = await render(entry);
---
<Layout
  title={`${entry.data.title} | Interdisciplinarist`}
  description={entry.data.excerpt}
  lang="en"
  canonicalPath={`${base}/articles/${entry.id}`}
  hreflang={false}
>
  <HeaderInter slot="header" />

  <article class="essay-page">
    <div class="max-w-[42rem] mx-auto px-8 py-20">
      <a href={`${base}/articles`} class="back-link">← All articles</a>
      <p class="eyebrow mt-6">{entry.data.tags.join(' · ')}</p>
      <h1 class="font-serif text-[2.6rem] font-normal leading-[1.15] text-ink mt-4 mb-10">{entry.data.title}</h1>
      <GatedContent tier={entry.data.tier} excerpt={entry.data.excerpt} source="article-reader">
        <div class="prose">
          <Content />
        </div>
      </GatedContent>
    </div>
  </article>

  <FooterInter slot="footer" />
</Layout>

<style>
  .back-link {
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .back-link:hover { color: var(--color-violet); }
  .eyebrow {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-violet);
  }
  .prose {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-ink);
  }
  .prose :global(p) {
    margin-bottom: 1.5rem;
  }
  .prose :global(h2) {
    font-size: 1.6rem;
    font-weight: 400;
    margin: 2.5rem 0 1rem;
    color: var(--color-ink);
  }
  .prose :global(h3) {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 2rem 0 0.75rem;
    color: var(--color-ink);
  }
  .prose :global(a) {
    color: var(--color-violet);
    text-decoration: underline;
    text-decoration-color: var(--color-stone);
  }
  .prose :global(blockquote) {
    border-left: 4px solid var(--color-violet);
    padding-left: 1.5rem;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 1.3rem;
    font-style: italic;
    color: var(--color-ink);
    margin: 2rem 0;
  }
</style>
