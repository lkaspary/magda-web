---
import Layout from '../../../layouts/Layout.astro';
import HeaderInter from '../../../components/HeaderInter.astro';
import FooterInter from '../../../components/FooterInter.astro';

const base = Astro.locals.site === 'interdisciplinarist' ? '' : '/inter';
---
<Layout
  title="Workbooks | Interdisciplinarist"
  description="Practical, structured guides for putting the thinking to work inside a real organization. Coming soon."
  lang="en"
  canonicalPath={`${base}/workbooks`}
  hreflang={false}
>
  <HeaderInter slot="header" />

  <div class="max-w-[68rem] mx-auto px-8 py-20">
    <p class="eyebrow">Interdisciplinarist</p>
    <h1 class="font-serif text-[3rem] font-normal leading-[1.1] text-ink mt-4 mb-6">Workbooks</h1>
    <p class="text-[1.15rem] leading-[1.8] text-ink mb-4">Practical, structured guides for putting the thinking to work inside a real organization. Coming soon.</p>
    <p class="text-[1rem] text-ink-muted leading-[1.75] mb-12">Want to be notified when the first workbook launches?</p>

    <div class="embed-wrapper">
      <iframe
        title="Newsletter signup"
        src="https://embeds.beehiiv.com/ab3b485e"
        data-test-id="beehiiv-embed"
        width="100%"
        height="320"
        frameborder="0"
        scrolling="no"
        style="border-radius: 4px; border: 1px solid #DDD9D3; margin: 0; background-color: transparent;"
      ></iframe>
    </div>
  </div>

  <FooterInter slot="footer" />
</Layout>

<style>
  .eyebrow {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-violet);
  }
  .embed-wrapper { max-width: 420px; }
</style>
