---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<Layout title="Palestras | Magda Kaspary" description="Magda fala sobre liderança, inteligência intercultural e cultura organizacional em conferências, eventos corporativos e programas executivos." lang="pt">
  <Header slot="header" />

  <div class="coming-soon-page">
    <div class="max-w-[52rem] mx-auto px-8 py-24">
      <p class="eyebrow">Em Breve</p>
      <h1 class="font-serif text-[3rem] font-normal leading-[1.1] text-ink mt-4 mb-8">Palestras</h1>
      <p class="text-[1.15rem] leading-[1.8] text-ink mb-4">Magda fala sobre liderança, inteligência intercultural e cultura organizacional em conferências, eventos corporativos e programas executivos. Detalhes completos em breve.</p>
      <p class="text-[1rem] text-ink-muted leading-[1.75] mb-12">Quer ser notificado quando esta página entrar no ar?</p>

      <div class="embed-wrapper">
        <iframe
          title="Inscrição na newsletter"
          src="https://embeds.beehiiv.com/34365e7e"
          data-test-id="beehiiv-embed"
          width="100%"
          height="320"
          frameborder="0"
          scrolling="no"
          style="border-radius: 4px; border: 1px solid #DDD9D3; margin: 0; background-color: transparent;"
        ></iframe>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>

<style>
  .coming-soon-page {
    min-height: 60vh;
    border-bottom: 1px solid var(--color-stone);
  }
  .eyebrow {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-teal);
  }
  .embed-wrapper {
    max-width: 42rem;
  }
</style>
