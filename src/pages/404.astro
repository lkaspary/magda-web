---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const base = `/${lang}`;

const copy = {
  en: {
    title: 'Page Not Found — Magda Kaspary',
    description: "This page doesn't exist — or it moved somewhere new.",
    heading: '404',
    message: "This page doesn't exist — or it moved somewhere new.",
    home: 'Back to home',
    newsletterHeading: 'Thinking across disciplines, in your inbox.',
    newsletterBody:
      'Essays on leadership, culture, and the art of building organizations that are both high-performing and deeply human — a few times a month.',
    beehiivForm: 'ab3b485e-a855-4dce-8ab9-31cddf8cabaa',
  },
  pt: {
    title: 'Página Não Encontrada — Magda Kaspary',
    description: 'Esta página não existe — ou foi movida para outro lugar.',
    heading: '404',
    message: 'Esta página não existe — ou foi movida para outro lugar.',
    home: 'Voltar para o início',
    newsletterHeading: 'Pensamento entre disciplinas, na sua caixa de entrada.',
    newsletterBody:
      'Ensaios sobre liderança, cultura e a arte de construir organizações que são ao mesmo tempo de alta performance e profundamente humanas — algumas vezes por mês.',
    beehiivForm: '34365e7e-c1f7-471a-9788-1eceb366c708',
  },
} as const;

const c = copy[lang];
---
<Layout title={c.title} description={c.description} lang={lang}>
  <Header slot="header" />

  <section class="max-w-[40rem] mx-auto px-6 py-24 text-center">
    <p class="font-serif text-[5rem] leading-none text-teal mb-4">{c.heading}</p>
    <p class="text-lg text-ink-muted mb-8">{c.message}</p>
    <a
      href={base}
      class="inline-block text-sm bg-teal text-white px-6 py-3 rounded hover:bg-teal-dark transition-colors"
    >
      {c.home}
    </a>
  </section>

  <section class="bg-teal">
    <div class="max-w-[68rem] mx-auto px-8 py-16 flex flex-wrap items-center justify-between gap-12">
      <div>
        <h2 class="font-serif text-[2rem] font-light text-white mb-2">{c.newsletterHeading}</h2>
        <p class="text-[0.95rem] leading-[1.6] max-w-[38rem]" style="color: rgba(255,255,255,0.75)">
          {c.newsletterBody}
        </p>
      </div>
      <div class="flex-shrink-0 min-w-[280px]">
        <script is:inline async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form={c.beehiivForm}></script>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
