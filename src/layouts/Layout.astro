---
import '../styles/global.css';
import { getAlternatePath } from '../i18n/utils';

export interface Props {
  title: string;
  description?: string;
  lang: 'en' | 'pt';
}
const { title, description = '', lang } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const enURL = new URL(getAlternatePath(Astro.url.pathname, 'en'), Astro.site);
const ptURL = new URL(getAlternatePath(Astro.url.pathname, 'pt'), Astro.site);
const ogLocale = lang === 'pt' ? 'pt_BR' : 'en_US';
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="pt" href={ptURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
  </head>
  <body class="bg-cream text-ink font-sans">
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>