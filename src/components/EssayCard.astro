---
export interface Props {
  title: string;
  excerpt: string;
  href: string;
  external?: boolean;
  linkLabel: string;
}
const { title, excerpt, href, external = false, linkLabel } = Astro.props;
---
<div class="essay-card">
  <h3 class="essay-card-title">{title}</h3>
  <p class="essay-card-excerpt">{excerpt}</p>
  <a
    href={href}
    class="essay-card-link"
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    {linkLabel}
  </a>
</div>

<style>
  .essay-card {
    border-top: 2px solid var(--color-teal);
    padding-top: 1.25rem;
  }
  .essay-card-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.25;
    margin-bottom: 0.75rem;
    color: var(--color-ink);
  }
  .essay-card-excerpt {
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    line-height: 1.65;
    margin-bottom: 1rem;
  }
  .essay-card-link {
    font-size: 0.8rem;
    color: var(--color-teal);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.03em;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
  }
  .essay-card-link:hover {
    border-color: var(--color-teal);
  }
</style>
